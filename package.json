{
  "name": "fpv-endurance",
  "private": true,
  "version": "0.7.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "check": "vue-tsc --noEmit",
    "build": "npm run check && vite build",
    "tauri": "tauri",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test:ui": "tsx scripts/android-parity-fixtures.ts && playwright test"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
